# =============================================================================
# ChessLearn Production Environment
# =============================================================================
# Copy this file to .env.production and fill in your values:
#   cp .env.production.example .env.production
# =============================================================================

# Your domain (used by nginx and certbot)
DOMAIN=chess.yourdomain.com

# Frontend URLs — must match your domain with https
NEXT_PUBLIC_API_URL=https://chess.yourdomain.com/api
NEXT_PUBLIC_WS_URL=wss://chess.yourdomain.com/ws

# Backend — the URL the server allows as CORS origin
FRONTEND_URL=https://chess.yourdomain.com

# Game settings
MAX_HINTS_PER_GAME=3
